{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "declarationMap": true,
    "outDir": "./dist",
    "types": ["react", "react-dom"],
    "jsx": "react-jsx",
    "lib": ["dom", "esnext"],
    "noEmit": false,
    "composite": true
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx"
  ],
  "exclude": [
    "src/**/*.stories.tsx",
    "src/**/*.test.tsx",
    "**/*.spec.ts"
  ]
}
